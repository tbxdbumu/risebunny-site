{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://:host/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/session/restore", "destination": "/api/session" },
    { "source": "/api/me", "destination": "/api/session" },
    { "source": "/api/shop/catalog", "destination": "/api/shop" },
    { "source": "/api/shop/buy", "destination": "/api/shop" },
    { "source": "/api/coupon/redeem", "destination": "/api/user" },
    { "source": "/api/deletion/request", "destination": "/api/user" },
    { "source": "/api/deletion/status", "destination": "/api/user" },
    { "source": "/api/log", "destination": "/api/user" },
    { "source": "/api/notify", "destination": "/api/user" },
    { "source": "/api/launcher/verify", "destination": "/api/launcher" },
    { "source": "/api/launcher/token", "destination": "/api/launcher" },
    { "source": "/api/launcher/device", "destination": "/api/launcher" },
    { "source": "/api/launcher/profile", "destination": "/api/launcher" },
    { "source": "/api/launcher/buy", "destination": "/api/launcher" },
    { "source": "/api/launcher/ticket", "destination": "/api/launcher" },
    { "source": "/api/launcher/avatar", "destination": "/api/launcher" },
    { "source": "/api/rank", "destination": "/api/rank/index" },
    { "source": "/api/rank/:id", "destination": "/api/rank/index" },
    { "source": "/api/leaderboard/rich", "destination": "/api/leaderboard" },
    { "source": "/api/leaderboard/level", "destination": "/api/leaderboard" },
    { "source": "/api/stats", "destination": "/api/public" },
    { "source": "/api/status", "destination": "/api/public" },
    { "source": "/api/firebase-config", "destination": "/api/public" },
    { "source": "/api/topgg/vote", "destination": "/api/webhooks" },
    { "source": "/api/client/:path*", "destination": "/api/client" },
    { "source": "/api/config/configs", "destination": "/api/auth/discord/config" },
    { "source": "/api/config/configs/:id", "destination": "/api/auth/discord/config" },
    { "source": "/api/contact", "destination": "/api/auth/discord/config" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://www.gstatic.com https://fonts.googleapis.com https://cdn.jsdelivr.net https://unpkg.com 'unsafe-inline'; style-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.jsdelivr.net 'unsafe-inline'; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://www.gstatic.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://formspree.io https://cdn.jsdelivr.net https://unpkg.com https://raw.githubusercontent.com https://media.githubusercontent.com https://threejs.org https://top.gg https://api.mymemory.translated.net https://translate.googleapis.com https://lingva.ml; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io mailto: https://top.gg"
        }
      ]
    }
  ]
}
