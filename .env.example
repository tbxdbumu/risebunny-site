# ══════════════════════════════════════════════════════════════════
# RiseBunny Site (rb-fixed) — Vercel environment örneği
# Değerlerin nereden alınacağı her bloğun üstünde yazıyor.
# ══════════════════════════════════════════════════════════════════

# Sitenin kendi adresi (Discord callback + Referer için kullanılır)
SITE_URL=https://risebunny.vercel.app
SITE_HOST=risebunny.vercel.app

# ── Discord OAuth ────────────────────────────────────────────────
# discord.com/developers → Applications → General Information
DISCORD_CLIENT_ID=
# aynı sayfa → Bot → Token / OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_PATH=/api/auth/discord/callback

# ── Firebase / Firestore (site REST erişimi) ─────────────────────
# Console → Project Settings → General → Your apps → Web app → SDK setup
FIREBASE_API_KEY=AIzaSyAq5Nafl9aI2TabzGsj5J9ij6lNwyfTguM
FIREBASE_PROJECT_ID=gen-lang-client-0590499912
FIREBASE_AUTH_DOMAIN=gen-lang-client-0590499912.firebaseapp.com
FIREBASE_STORAGE_BUCKET=gen-lang-client-0590499912.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Console → Authentication → Users (admin hesapların UID'leri, virgülle)
ADMIN_UIDS=oblLBCNGXEYF8plKq8KUr3m6o4f1,1310366324731547798
# Bot üzerinden gelen isteklerde kabul edilen Discord ID'ler
ADMIN_DISCORD_IDS=985126554306773063,1310366324731547798

# ── Oturum sırrı ─────────────────────────────────────────────────
# Kendin üret: openssl rand -hex 32 — BOT .env'deki SESSION_SECRET ile AYNI olmalı
SESSION_SECRET=

# ── Bot API köprüsü (canlı sayılar: kullanıcı/komut/kategori) ────
# Botun public adresi (Render/Replit/VPS): https://<bot-adresi>
BOT_API_URL=
# BOT .env'deki BOT_API_SECRET ile BİREBİR AYNI olmalı
BOT_API_SECRET=

# ── top.gg (canlı sunucu + aylık oy sayısı) ───────────────────────
TOPGG_BOT_ID=1540401487581020252
# top.gg → Manage your bot → Webhooks & API → Bot API Token
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=

# ── Launcher ─────────────────────────────────────────────────────
# Masaüstü launcher'ın BEARER tokenini imzalayan sır.
# BOŞ BIRAKILIRSA `SESSION_SECRET` kullanılır (api/rank/index.js).
# Sadece token imzasını launcher'dan ayrı tutmak istiyorsan doldur:
# openssl rand -hex 32
LAUNCHER_TOKEN_SECRET=
# Sabit premium Discord ID'leri (virgülle) — normalde bot/Firestore decides
LAUNCHER_PREMIUM_IDS=
