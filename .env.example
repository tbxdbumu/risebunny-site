# ══════════════════════════════════════════════════════════════════
# RiseBunny Site (rb-main) — Vercel environment (.env.example)
# Vercel → Project → Settings → Environment Variables olarak da girilir.
# İPUCU: İstemci (js/firebase-config.js) config'i gömülüdür — web API key
#   gizli değildir, oradan okunur. BU DOSYADAKİLER SADECE serverless
#   fonksiyonları (api/*.js) içindir ve SIRDIR.
# ══════════════════════════════════════════════════════════════════

# Firebase Console → Project Settings → General → Your apps → Web app:
FIREBASE_API_KEY=AIzaSyAq5Nafl9aI2TabzGsj5J9ij6lNwyfTguM
FIREBASE_PROJECT_ID=gen-lang-client-0590499912

# Bu sitenin kendi adresi
SITE_URL=https://risebunny.vercel.app

# ── Discord OAuth (site girişi) ──────────────────────────────────
# discord.com/developers → Application → OAuth2:
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_PATH=/api/auth/callback

# ── Bot API'sine erişim (canlı sayılar + kullanıcı/premium) ──────
# Botun Express sunucusunun dışa açık adresi (Render/Railway/VPS URL'i).
# DOLU OLMAZSA "Canlı Sayılar" gerçek bot verisini çekemez!
BOT_API_URL=
# Botun .env'indeki BOT_API_SECRET ile BİREBİR AYNI olmalı:
BOT_API_SECRET=

# ── top.gg (canlı oy/sunucu sayısı için GEREKLİ) ─────────────────
# top.gg → bot → Manage → Webhooks & API → Bot API Token.
# DOLU OLMAYANCA "Oy (aylık)" ve top.gg sunucu sayısı gelmez.
TOPGG_TOKEN=
TOPGG_BOT_ID=1540401487581020252
TOPGG_WEBHOOK_SECRET=

# ── Oturum / bilet imzalama sırları ──────────────────────────────
# Kendin üret: openssl rand -hex 32 (bot ile aynı olması gereken: TICKET_SECRET, SESSION_SECRET)
SESSION_SECRET=
TICKET_SECRET=

# Comma-separated Discord ID'leri (launcher'da her zaman premium sayılanlar)
LAUNCHER_PREMIUM_IDS=
